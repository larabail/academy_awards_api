---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="That page is not part of this programme."
  noindex={true}
  section="home"
>
  <main id="main" class="lost">
    <span class="eyebrow">No such category</span>
    <h1>That page is not on the programme.</h1>
    <p class="lede">
      The link may be old, or slightly mistyped. The reference is the best place to pick the thread
      back up.
    </p>
    <div class="actions">
      <a class="btn" href="/reference">Go to the reference</a>
      <a class="btn ghost" href="/">Back to the cover</a>
    </div>
  </main>
</Base>

<style>
  .lost {
    max-width: 82rem;
    margin: 0 auto;
    padding: clamp(3rem, 10vw, 7rem) var(--gutter) 6rem;
  }
</style>
