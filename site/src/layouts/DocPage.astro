---
/** A documentation page: contents on the left, cream insert page on the right. */
import Base from './Base.astro';
import Contents from '../components/Contents.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  section?: 'guides' | 'reference' | 'account';
  noindex?: boolean;
}

const { title, description, eyebrow, section = 'guides', noindex } = Astro.props;
---

<Base title={title} description={description} section={section} noindex={noindex}>
  <div class="shell">
    <Contents />
    <main id="main" class="stock">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      <slot />
    </main>
  </div>
</Base>
