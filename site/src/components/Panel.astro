---
/** Code set as a figure: hairline rules and a caption, not a boxed panel. */
interface Props {
  label: string;
  code: string;
}
const { label, code } = Astro.props;
---

<figure class="figure">
  <figcaption class="figure-head">
    <span class="label">{label}</span>
    <button class="copy" type="button" data-copy hidden>Copy</button>
  </figcaption>
  <pre><code>{code}</code></pre>
</figure>
