---
/**
 * The contents list. The API key deliberately is not here — it lives in the
 * masthead as a primary action, because it is the thing most visitors came for
 * and burying it at the bottom of a sidebar hid it.
 */
import { guides, endpoints } from '../data/api';
import { canonicalPath } from '../lib/path';

const here = canonicalPath(Astro.url.pathname);
const isCurrent = (href: string) => (here === href ? 'page' : undefined);
---

<nav class="contents" aria-label="Documentation">
  <h2>Guides</h2>
  <ol>
    {
      guides.map((g, i) => (
        <li>
          <a href={`/docs/${g.slug}`} aria-current={isCurrent(`/docs/${g.slug}`)}>
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span>{g.title}</span>
          </a>
        </li>
      ))
    }
  </ol>

  <h2>Reference</h2>
  <ol>
    <li>
      <a href="/reference" aria-current={isCurrent('/reference')}>
        <span class="num" aria-hidden="true">&mdash;</span>
        <span>Overview</span>
      </a>
    </li>
    {
      endpoints.map((e) => (
        <li>
          <a href={`/reference/${e.slug}`} aria-current={isCurrent(`/reference/${e.slug}`)}>
            <span class="num" aria-hidden="true">
              {e.number}
            </span>
            <span>{e.title}</span>
          </a>
        </li>
      ))
    }
  </ol>

  <h2>Reference data</h2>
  <ol>
    <li>
      <a href="/openapi.json">
        <span class="num" aria-hidden="true">&mdash;</span>
        <span>OpenAPI document</span>
      </a>
    </li>
  </ol>
</nav>
